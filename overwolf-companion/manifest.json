{
  "manifest_version": 1,
  "type": "WebApp",
  "permissions": ["GameInfo"],
  "meta": {
    "name": "Chibi Overwolf Companion",
    "author": "HelioConde",
    "version": "0.0.2",
    "minimum-overwolf-version": "0.311.0.6",
    "minimum-gep-version": "143.0",
    "description": "Public TFT companion shell with player-facing desktop UI and verified GEP telemetry.",
    "icon": "assets/icon.png"
  },
  "data": {
    "game_targeting": {
      "type": "dedicated",
      "game_ids": [5426]
    },
    "game_events": [5426],
    "developer": {
      "enable_auto_refresh": true,
      "reload_delay": 1000,
      "filter": "*.json;*.html;*.js"
    },
    "start_window": "background",
    "windows": {
      "background": {
        "file": "index.html",
        "is_background_page": true
      },
      "desktop": {
        "file": "desktop.html",
        "transparent": false,
        "resizable": true,
        "desktop_only": true,
        "show_minimize": true,
        "show_maximize": false,
        "size": {
          "width": 1100,
          "height": 720
        },
        "min_size": {
          "width": 840,
          "height": 560
        }
      }
    }
  }
}
